[Unit]
Description=MLFlow service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mlops/MLOps-MLFlow
ExecStart=/home/ubuntu/.pyenv/shims/mlflow server --host 0.0.0.0 --port 5000 --backend-store-uri sqlite:///mlflow.db --artifacts-destination s3://eia-bubket-atl/mlflow/

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
